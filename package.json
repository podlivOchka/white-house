{
  "name": "white-house",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assets": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/catalog.test.ts tests/server/*.test.ts",
    "build": "npm run assets && npm run typecheck && vite build && node --experimental-strip-types scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "admin:set": "node --env-file-if-exists=.env --experimental-strip-types server/admin-cli.ts",
    "dev:server": "node --env-file-if-exists=.env --experimental-strip-types --watch server/index.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^6.0.0",
    "@netlify/identity": "^2.0.0",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
